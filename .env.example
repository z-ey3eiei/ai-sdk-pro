# Copy to .env on the VPS. Never commit .env or expose model keys in browser code.
# Configure DNS only after verifying the VPS target for your registered domain.
DOMAIN=ai-sdk.pro
ACME_EMAIL=sdkbank@1origin.dev

# Public chat: visitors bring their own key; never fall back to owner credentials.
BYOK_ONLY=true

# Optional private-development provider configuration when BYOK_ONLY=false.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
AI_API_KEY=
# For AI_PROVIDER=compatible, set the vendor's OpenAI-compatible /v1 endpoint.
AI_BASE_URL=
APP_ORIGINS=https://ai-sdk.pro

# Optional private owner MCP. Visitor BYOK requests do not receive these tools.
MCP_SERVER_URL=
MCP_AUTH_TOKEN=

# Optional immutable image reference for GitHub Actions deployments.
# GHCR_IMAGE=ghcr.io/your-github-owner/ai-sdk-pro-web:commit-sha

# DigitalOcean tokens manage infrastructure; they are NOT model keys.
# Store infrastructure/admin credentials separately in an operator secret store,
# never in this app .env file or in the application container.

# Better Auth social login + repository workspace (server-only; separate from model BYOK).
BETTER_AUTH_URL=https://ai-sdk.pro
BETTER_AUTH_SECRET=
NEON_DATABASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GITHUB_APP_SLUG=ai-sdk-pro
# OAuth callbacks: https://ai-sdk.pro/api/auth/callback/{github|google|facebook|apple}
# GitHub App installation remains separate and is used to grant repository access.
# Apple client secrets are signed JWTs and must be refreshed before their expiry.
# Import snapshots do not execute/build/deploy repository code.

# Optional feature flags; Flags SDK runs locally on the VPS, with no Vercel hosting required.
# FLAGS_SECRET is needed for secure overrides/Explorer; do not expose it to the client.
FLAGS_SECRET=
DEPLOY_EXPERIMENTS_ENABLED=false
BLOB_UPLOADS_ENABLED=false

# Optional Vercel Blob: create a PRIVATE store. Leave unset to disable uploads.
# The read-write token is server-only. Never use NEXT_PUBLIC_ or include it in client JS.
BLOB_READ_WRITE_TOKEN=

