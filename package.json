{
  "name": "ai-sdk-pro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --filter @aisdkpro/web dev",
    "dev:docs": "pnpm --filter @aisdkpro/docs dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check": "pnpm typecheck",
    "test": "vitest run",
    "start": "pnpm --filter @aisdkpro/web start",
    "agent:smoke": "pnpm --filter @aisdkpro/web agent:smoke"
  },
  "devDependencies": { "turbo": "^2.6.0", "typescript": "5.9.3", "vitest": "^2.1.4", "@types/node": "^22.0.0", "tsx": "^4.20.0" }
}
