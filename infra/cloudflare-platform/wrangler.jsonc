{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aisdkpro-platform-api-staging",
  "main": "src/api.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "traces": {"enabled": true, "head_sampling_rate": 0.1}},
  "routes": [{"pattern": "deploy-staging.ai-sdk.pro", "custom_domain": true}],
  "assets": {"directory": "./dashboard", "binding": "DASHBOARD", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "aisdkpro-platform-staging", "database_id": "69978225-4049-47f6-b761-b402b73cdda3", "migrations_dir": "./migrations"}],
  "kv_namespaces": [{"binding": "ROUTES", "id": "758c9c8189e14c96978c9ea8d9b9bf94"}],
  "r2_buckets": [{"binding": "BUILD_DATA", "bucket_name": "aisdkpro-platform-staging-builds"}],
  "queues": {
    "producers": [{"binding": "DEPLOY_QUEUE", "queue": "aisdkpro-platform-staging-deploy"}],
    "consumers": [{"queue": "aisdkpro-platform-staging-deploy", "max_batch_size": 5, "max_retries": 5, "dead_letter_queue": "aisdkpro-platform-staging-dead"}]
  },
  "workflows": [{"binding": "DEPLOYMENT", "name": "aisdkpro-platform-staging-deployment", "class_name": "DeploymentWorkflow"}],
  "triggers": {"crons": ["*/5 * * * *"]},
  "containers": [{"class_name": "BuildSandbox", "image": "docker.io/cloudflare/sandbox:0.12.14", "instance_type": "standard-1", "max_instances": 2}],
  "durable_objects": {"bindings": [{"name": "BUILD_SANDBOX", "class_name": "BuildSandbox"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["BuildSandbox"]}],
  "vars": {
    "API_ORIGIN": "https://deploy-staging.ai-sdk.pro",
    "PROJECT_DOMAIN": "ai-sdk.pro",
    "CLOUDFLARE_ACCOUNT_ID": "2d92bd5b25768fa9093d6adc0a8887fc",
    "DISPATCH_NAMESPACE": "aisdkpro-platform-staging",
    "GITHUB_APP_SLUG": "ai-sdk-pro",
    "GITHUB_CLIENT_ID": "Iv23liL0Mb8HQeuqbTgE",
    "FRAMEWORK_BUILDS": "disabled",
    "PLATFORM_BRIDGE_ENABLED": "false",
    "PROJECT_ROUTING_READY": "false",
    "PUBLIC_DEPLOY_ENABLED": "false",
    "BETA_GITHUB_IDS": "312459747",
    "SAAS_ZONE_ID": "",
    "SAAS_CNAME_TARGET": ""
  }
}
